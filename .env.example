# Copy to `.env` and fill in from your Supabase project settings.
# When set, Mac + iPhone sync through Supabase instead of local-only storage.
#
# To share Rollout Studio with others:
# 1. Create one Supabase project for your team/install
# 2. Run supabase/migrations/001_rollout_studio.sql in the SQL editor
# 3. Put the same .env on every Mac/iPhone build
# 4. Each person creates their own sign-in (data stays private per account)

VITE_SUPABASE_URL=https://fwsmllrlevehhxdtzzkk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Apple Calendar auto-sync (Mac CLI — optional)
# Use your full Apple ID email (not your account password).
# Generate an app-specific password at https://appleid.apple.com
ICLOUD_APPLE_ID=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ROLLOUT_CALENDAR_NAME=Home
ROLLOUT_TIMEZONE=America/New_York
ROLLOUT_ALERT_MINUTES=30
ROLLOUT_PROJECT_ID=fuckdahaters

# Pushcut active push nudges (optional — calendar alerts work without this)
# Create a notification named RolloutNudge in the Pushcut iPhone app first.
# PUSHCUT_API_KEY=
# PUSHCUT_NOTIFICATION_NAME=RolloutNudge
ROLLOUT_PUSH_BY_DEFAULT=1
ROLLOUT_PUSH_LEAD_MINUTES=15

# Local-only desktop mode (only used when Supabase vars above are empty)
# VITE_API_BASE=http://127.0.0.1:3847

# Growth hub integration links (optional — defaults to public URLs)
# VITE_SUBMITHUB_URL=https://www.submithub.com/
# VITE_SPOTIFY_PITCH_URL=https://artists.spotify.com/c/music/spotify-for-artists/pitching/
# VITE_SOUNDCLOUD_URL=https://soundcloud.com/you/stats
# VITE_YOUTUBE_STUDIO_URL=https://studio.youtube.com/
# VITE_INSTAGRAM_INSIGHTS_URL=https://www.instagram.com/accounts/insights/
# VITE_TIKTOK_ANALYTICS_URL=https://www.tiktok.com/creator-center/analytics

# Admin dashboard (cloud mode — optional override)
# VITE_ADMIN_EMAIL=killscomfort@gmail.com
