{
  "name": "rollout-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone rollout checklist app for music releases — Mac, iPhone, and cloud sync",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/run-dev.cjs",
    "dev:local": "concurrently -k \"npm:dev:server\" \"npm:dev:client:local\" \"npm:dev:electron\"",
    "dev:cloud": "concurrently -k \"npm:dev:client:cloud\" \"npm:dev:electron:cloud\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:client:local": "VITE_ROLLOUT_BACKEND=local vite --config client/vite.config.ts",
    "dev:client:cloud": "VITE_ROLLOUT_BACKEND=cloud vite --config client/vite.config.ts",
    "dev:electron": "wait-on http://127.0.0.1:5173 http://127.0.0.1:3847/health && ROLLOUT_USE_VITE=1 electron .",
    "dev:electron:cloud": "wait-on http://127.0.0.1:5173 && ROLLOUT_USE_VITE=1 ROLLOUT_USE_CLOUD=1 electron .",
    "setup:cloud": "node scripts/setup-cloud.cjs check",
    "setup:supabase": "node scripts/supabase-bootstrap.cjs",
    "user:stats": "node scripts/user-stats.cjs",
    "build": "node scripts/run-build.cjs",
    "build:client": "VITE_ROLLOUT_BACKEND=cloud vite build --config client/vite.config.ts",
    "build:client:local": "VITE_ROLLOUT_BACKEND=local VITE_API_BASE=http://127.0.0.1:3847 vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json && cp server/dist-package.json server/dist/package.json",
    "start": "node scripts/run-start.cjs",
    "start:local": "node scripts/run-build.cjs && electron .",
    "start:cloud": "node scripts/run-build.cjs && electron .",
    "pack:mac": "node scripts/run-build.cjs && electron-builder --mac dir",
    "release:mac": "node scripts/run-build.cjs && electron-builder --mac zip dmg --publish never",
    "apply:desktop": "node scripts/install-desktop.cjs",
    "build:mobile": "VITE_API_BASE= vite build --config client/vite.config.ts",
    "build:ios": "npm run build:mobile && npx cap sync ios",
    "open:ios": "npx cap open ios",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "check": "node scripts/check.cjs",
    "sync:icloud": "node scripts/rollout-notifications/run-cli.cjs --sync",
    "push:nudges": "node scripts/rollout-notifications/run-cli.cjs --push",
    "sync:notifications": "node scripts/rollout-notifications/run-cli.cjs",
    "notifications:preview": "node scripts/rollout-notifications/run-cli.cjs --preview --project=fuckdahaters",
    "notifications:test-push": "node scripts/rollout-notifications/run-cli.cjs --test-push",
    "notifications:test-calendar": "node scripts/rollout-notifications/run-cli.cjs --test-calendar --in=3"
  },
  "build": {
    "appId": "com.rolloutstudio.app",
    "productName": "Rollout Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@supabase/supabase-js": "^2.49.8",
    "better-sqlite3": "^11.9.1",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ical-generator": "^7.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdav": "^2.1.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.2.0",
    "electron-builder": "^26.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
