{
  "name": "rollout-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone desktop rollout checklist — customizable per project",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:electron\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:electron": "wait-on http://127.0.0.1:5173 http://127.0.0.1:3847/health && ROLLOUT_USE_VITE=1 electron .",
    "build": "npm run build:client && npm run build:server",
    "build:client": "VITE_API_BASE=http://127.0.0.1:3847 vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json && cp server/dist-package.json server/dist/package.json",
    "start": "npm run build && electron .",
    "pack:mac": "npm run build && electron-builder --mac dir",
    "apply:desktop": "npm run pack:mac && node scripts/install-desktop.cjs",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "build": {
    "appId": "com.killscomfort.rollout-studio",
    "productName": "Rollout Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.2.0",
    "electron-builder": "^26.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
